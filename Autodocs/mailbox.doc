mailbox.resource/MB_StringCommand             mailbox.resource/MB_StringCommand

   NAME
	MB_StringCommand -- send a vcgencmd-style text command (V1.0)

   SYNOPSIS
	length = MB_StringCommand( command, reply, reply_capacity )
	d0                         a0       a1     d0

	ULONG MB_StringCommand(STRPTR, STRPTR, ULONG);

   FUNCTION
	Sends a null-terminated ASCII command string using the
	GET_GENCMD_RESULT property tag (0x00030080), the same tag
	vcgencmd uses on Linux, and copies the firmware's text reply
	into the caller's buffer.

   INPUTS
	command         A null-terminated ASCII command string, e.g.
	                "measure_temp". May not exceed 1023 characters.
	reply           A buffer to receive the reply text, or NULL to discard
	                it.
	reply_capacity  The size in bytes of the reply buffer. The reply is
	                truncated to whichever is smaller: this value or 1024.

   RESULTS
	length          The reply length reported by the firmware, or -1 on a
	                mailbox transport error or an oversized command
	                string.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    UBYTE reply[256];

	    MB_StringCommand("measure_temp", reply, sizeof(reply));
	    Printf("vcgencmd reply: %s\n", reply);
	}

   SEE ALSO
	mailbox.resource/MB_RawCommand()

mailbox.resource/MB_UnlockMemory               mailbox.resource/MB_UnlockMemory

   NAME
	MB_UnlockMemory -- unlock a GPU memory handle (V1.1)

   SYNOPSIS
	status = MB_UnlockMemory( handle )
	d0                        d0

	ULONG MB_UnlockMemory(ULONG);

   FUNCTION
	Unlocks a GPU memory block previously locked by MB_LockMemory(),
	using property tag UNLOCK_MEMORY (0x0003000e).

   INPUTS
	handle          A handle returned by MB_AllocateMemory().

   RESULTS
	status          0 on success, or -1 on a mailbox transport error.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG handle = MB_AllocateMemory(4096, 4, MEM_FLAG_COHERENT);
	    ULONG busAddr = MB_LockMemory(handle);

	    /* ... use the block at busAddr ... */

	    MB_UnlockMemory(handle);
	}

   SEE ALSO
	mailbox.resource/MB_LockMemory(),
	mailbox.resource/MB_ReleaseMemory()

