mailbox.resource/MB_SetOverscan                 mailbox.resource/MB_SetOverscan

   NAME
	MB_SetOverscan -- set the framebuffer overscan margins (V1.1)

   SYNOPSIS
	status = MB_SetOverscan( overscan )
	d0                       a0

	ULONG MB_SetOverscan(ULONG *);

   FUNCTION
	Sets the framebuffer's overscan margins, using property tag
	SET_OVERSCAN (0x0004800a).

   INPUTS
	overscan        A pointer to an array of 4 ULONGs holding [top,
	                bottom, left, right] on entry; overwritten with the
	                actually applied values on return.

   RESULTS
	status          0 on success, or -1 on a mailbox transport error.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG overscan[4] = { 0, 0, 0, 0 };

	    MB_SetOverscan(overscan);
	    Printf("Overscan applied: %ld %ld %ld %ld\n",
	        overscan[0], overscan[1], overscan[2], overscan[3]);
	}

   SEE ALSO
	mailbox.resource/MB_GetOverscan(),
	mailbox.resource/MB_SetDisplayNum()

mailbox.resource/MB_SetPalette                   mailbox.resource/MB_SetPalette

   NAME
	MB_SetPalette -- set a range of the 256-entry RGBA palette (V1.1)

   SYNOPSIS
	status = MB_SetPalette( offset, count, colors )
	d0                      d0      d1     a0

	ULONG MB_SetPalette(ULONG, ULONG, ULONG *);

   FUNCTION
	Sets 'count' consecutive palette entries starting at 'offset',
	using property tag SET_PALETTE (0x0004800b).

   INPUTS
	offset          The index of the first palette entry to set.
	count           The number of consecutive entries to set; must not
	                exceed 256.
	colors          A pointer to an array of 'count' RGBA ULONGs.

   RESULTS
	status          0 on success, 1 if the firmware reported an invalid
	                palette index, or -1 on a mailbox transport error or
	                an oversized count.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG red = 0xff0000ff;

	    ULONG status = MB_SetPalette(1, 1, &red);
	    Printf("MB_SetPalette status: %ld\n", status);
	}

   NOTE
	This function's buffer layout follows the officially documented
	property-tag format, but it has not yet been exercised against
	real hardware -- validate before relying on it.

   SEE ALSO
	mailbox.resource/MB_GetPalette(),
	mailbox.resource/MB_SetDisplayNum()

mailbox.resource/MB_SetPhysicalSize         mailbox.resource/MB_SetPhysicalSize

   NAME
	MB_SetPhysicalSize -- set the framebuffer physical (display) size (V1.1)

   SYNOPSIS
	MB_SetPhysicalSize( width, height, actual_width, actual_height )
	                    d0     d1      a0            a1

	VOID MB_SetPhysicalSize(ULONG, ULONG, ULONG *, ULONG *);

   FUNCTION
	Sets the framebuffer's physical (visible display) size in
	pixels, using property tag SET_PHYSICAL_SIZE (0x00048003).

   INPUTS
	width           The desired width in pixels.
	height          The desired height in pixels.
	actual_width    Receives the width actually applied, or NULL to
	                discard.
	actual_height   Receives the height actually applied, or NULL to
	                discard.

   RESULTS
	The firmware may adjust the requested size (e.g. alignment or
	mode constraints); on error, both *actual_width and
	*actual_height are set to -1.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG width, height;

	    MB_SetPhysicalSize(1920, 1080, &width, &height);
	    Printf("Physical size applied: %ld x %ld\n", width, height);
	}

   SEE ALSO
	mailbox.resource/MB_GetPhysicalSize(),
	mailbox.resource/MB_SetVirtualSize(),
	mailbox.resource/MB_SetDisplayNum()

