mailbox.resource/MB_GetBoardRevision       mailbox.resource/MB_GetBoardRevision

   NAME
	MB_GetBoardRevision -- read the raw board revision code (V1.1)

   SYNOPSIS
	revision = MB_GetBoardRevision()
	d0

	ULONG MB_GetBoardRevision(VOID);

   FUNCTION
	Reads the raw 32-bit board revision code, using property tag
	GET_BOARD_REVISION (0x00010002). The value packs the board's
	overvoltage/OTP/warranty flags, memory size, manufacturer,
	processor and revision fields; decoding it is the caller's
	responsibility.

   RESULTS
	revision        The raw board revision code, or -1 on a mailbox
	                transport error.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG revision = MB_GetBoardRevision();
	    Printf("Board revision: %08lx\n", revision);
	}

   SEE ALSO
	mailbox.resource/MB_GetBoardModel(),
	mailbox.resource/MB_GetFirmwareRevision()

mailbox.resource/MB_GetBoardSerial           mailbox.resource/MB_GetBoardSerial

   NAME
	MB_GetBoardSerial -- read the board's 64-bit serial number (V1.1)

   SYNOPSIS
	MB_GetBoardSerial( hi, lo )
	                   a0  a1

	VOID MB_GetBoardSerial(ULONG *, ULONG *);

   FUNCTION
	Reads the board's 64-bit serial number, using property tag
	GET_BOARD_SERIAL (0x00010004).

   INPUTS
	hi              Receives the serial number's high 32 bits, or NULL to
	                discard.
	lo              Receives the serial number's low 32 bits, or NULL to
	                discard.

   RESULTS
	On error, both *hi and *lo are set to -1.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG hi, lo;

	    MB_GetBoardSerial(&hi, &lo);
	    Printf("Serial: %08lx%08lx\n", hi, lo);
	}

   NOTE
	Unlike every other property tag in this resource, the firmware
	hands this one back as a raw byte blob rather than two proper
	32-bit values, so it must NOT be byte-swapped -- confirmed on
	real hardware by working out the math from an actual wrong-
	looking reading (with a swap applied, the expected RPi4 serial
	"10000000c937f849" came out as "0000001049f837c9").

   SEE ALSO
	mailbox.resource/MB_GetBoardMACAddress()

mailbox.resource/MB_GetClockRate               mailbox.resource/MB_GetClockRate

   NAME
	MB_GetClockRate -- read a clock's configured rate (V1.0)

   SYNOPSIS
	rate = MB_GetClockRate( clock_id )
	d0                      d0

	ULONG MB_GetClockRate(ULONG);

   FUNCTION
	Reads the configured rate of a VideoCore-managed clock, using
	property tag GET_CLOCK_RATE (0x00030002).

   INPUTS
	clock_id        The clock to query, e.g. CLK_ARM_ID, CLK_CORE_ID,
	                CLK_V3D_ID (see resources/mailbox.h for the full
	                CLK_*_ID enum).

   RESULTS
	rate            The clock's configured rate in Hz, or -1 on a mailbox
	                transport error.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG rate = MB_GetClockRate(CLK_ARM_ID);
	    Printf("ARM clock: %ld Hz\n", rate);
	}

   SEE ALSO
	mailbox.resource/MB_SetClockRate(),
	mailbox.resource/MB_GetClockRateMeasured(),
	mailbox.resource/MB_GetClockRateMin(),
	mailbox.resource/MB_GetClockRateMax()

mailbox.resource/MB_GetClockRateMax         mailbox.resource/MB_GetClockRateMax

   NAME
	MB_GetClockRateMax -- read a clock's maximum allowed rate (V1.1)

   SYNOPSIS
	rate = MB_GetClockRateMax( clock_id )
	d0                         d0

	ULONG MB_GetClockRateMax(ULONG);

   FUNCTION
	Reads the maximum rate a clock is allowed to run at, using
	property tag GET_CLOCKRATE_MAX (0x00030004). Reflects
	config.txt's arm_freq/over_voltage settings, so it already
	accounts for a user's overclock rather than a fixed stock value.

   INPUTS
	clock_id        The clock to query, see CLK_*_ID in
	                resources/mailbox.h.

   RESULTS
	rate            The clock's maximum allowed rate in Hz, or -1 on a
	                mailbox transport error.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG rate = MB_GetClockRateMax(CLK_ARM_ID);
	    Printf("ARM clock max: %ld Hz\n", rate);
	}

   SEE ALSO
	mailbox.resource/MB_GetClockRate(),
	mailbox.resource/MB_GetClockRateMin()

mailbox.resource/MB_GetClockRateMeasured mailbox.resource/MB_GetClockRateMeasured

   NAME
	MB_GetClockRateMeasured -- read a clock's actual measured rate (V1.1)

   SYNOPSIS
	rate = MB_GetClockRateMeasured( clock_id )
	d0                              d0

	ULONG MB_GetClockRateMeasured(ULONG);

   FUNCTION
	Reads a clock's actual measured rate (as opposed to the
	configured rate returned by MB_GetClockRate()), using property
	tag GET_CLOCK_RATE_M (0x00030047). Used e.g. for the
