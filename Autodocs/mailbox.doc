	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG handle = MB_AllocateMemory(4096, 4, MEM_FLAG_COHERENT);

	    /* ... use the block via MB_LockMemory() ... */

	    MB_ReleaseMemory(handle);
	}

   SEE ALSO
	mailbox.resource/MB_AllocateMemory(),
	mailbox.resource/MB_UnlockMemory()

mailbox.resource/MB_SetAlphaMode               mailbox.resource/MB_SetAlphaMode

   NAME
	MB_SetAlphaMode -- set the framebuffer alpha channel mode (V1.1)

   SYNOPSIS
	mode = MB_SetAlphaMode( mode )
	d0                      d0

	ULONG MB_SetAlphaMode(ULONG);

   FUNCTION
	Sets the framebuffer's alpha channel mode, using property tag
	SET_ALPHA_MODE (0x00048007).

   INPUTS
	mode            0 = enabled, 1 = reversed, 2 = ignored -- see
	                MB_GetAlphaMode().

   RESULTS
