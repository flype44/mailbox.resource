mailbox.resource/MB_AllocateBuffer           mailbox.resource/MB_AllocateBuffer

   NAME
	MB_AllocateBuffer -- allocate the framebuffer (V1.1)

   SYNOPSIS
	MB_AllocateBuffer( alignment, base, size )
	                   d0         a0    a1

	VOID MB_AllocateBuffer(ULONG, ULONG *, ULONG *);

   FUNCTION
	Allocates the framebuffer, using property tag ALLOCATE_BUFFER
	(0x00040001). Must be called after Set(Physical|Virtual)Size()
	and MB_SetDepth() have configured the mode; call
	MB_ReleaseBuffer() when done with it.

   INPUTS
	alignment       The requested framebuffer base alignment in bytes
	                (e.g. 64).
	base            Receives the allocated framebuffer's base address, or
	                NULL to discard.
	size            Receives the allocated framebuffer's size in bytes, or
	                NULL to discard.

   RESULTS
	On error, both *base and *size are set to -1.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG base, size;

	    MB_AllocateBuffer(64, &base, &size);
	    Printf("Framebuffer: %lx, %ld bytes\n", base, size);

	    /* ... use the framebuffer ... */

	    MB_ReleaseBuffer();
	}

   SEE ALSO
	mailbox.resource/MB_ReleaseBuffer(),
	mailbox.resource/MB_SetPhysicalSize(),
	mailbox.resource/MB_SetDepth(), mailbox.resource/MB_GetPitch(),
	mailbox.resource/MB_SetDisplayNum()

mailbox.resource/MB_AllocateMemory           mailbox.resource/MB_AllocateMemory

   NAME
	MB_AllocateMemory -- allocate GPU memory (V1.1)

   SYNOPSIS
	handle = MB_AllocateMemory( size, alignment, flags )
	d0                          d0    d1         d2

	ULONG MB_AllocateMemory(ULONG, ULONG, ULONG);

   FUNCTION
	Generic VideoCore GPU memory allocator, using property tag
	ALLOCATE_MEMORY (0x0003000c). Useful for anything the ARM side
	needs the GPU to see, e.g. uploading VC4 code for execution.

   INPUTS
	size            The size in bytes to allocate.
	alignment       The required alignment in bytes (e.g. 4).
	flags           A bitmask of MEM_FLAG_* values defined in
	                resources/mailbox.h (e.g. MEM_FLAG_COHERENT |
	                MEM_FLAG_DIRECT | MEM_FLAG_HINT_PERMALOCK for CPU-
	                uncached, non-relocatable memory).

   RESULTS
	handle          An opaque handle to be passed to MB_LockMemory(), or
	                -1 on a mailbox transport error.

   EXAMPLES
	Upload a small VC4 code fragment and get its bus address:

	    #include <exec/types.h>
	    #include <exec/execbase.h>
	    #include <proto/exec.h>
	    #include <proto/mailbox.h>
	    #include <resources/mailbox.h>

	    extern struct ExecBase *SysBase;
	    APTR MailboxBase;

	    ULONG handle, busAddr;
	    UBYTE *vc4Code;

	    MailboxBase = OpenResource(MAILBOXNAME);
	    if (MailboxBase)
	    {
	        handle = MB_AllocateMemory(code_size, 4,
	            MEM_FLAG_COHERENT | MEM_FLAG_DIRECT | MEM_FLAG_HINT_PERMALOCK);

	        if (handle)
	        {
	            busAddr = MB_LockMemory(handle);
	            vc4Code = (UBYTE *)(busAddr & 0x3fffffff);

	            CopyMem(code, vc4Code, code_size);
	            CacheClearE(vc4Code, code_size, CACRF_ClearD);

	            /* ... hand busAddr to the GPU, e.g. via GET_EXECUTE_CODE ... */

	            MB_UnlockMemory(handle);
	            MB_ReleaseMemory(handle);
	        }
	    }

	Resources are never closed with a Close call: once OpenResource()
	succeeds, MailboxBase stays valid until the machine is reset.

   NOTE
	The MEM_FLAG_* values follow the official raspberrypi/firmware
	wiki convention, but are not confirmed against any repo in this
	workspace and have not yet been exercised on real hardware --
	verify before relying on them.

   SEE ALSO
	mailbox.resource/MB_LockMemory(),
	mailbox.resource/MB_UnlockMemory(),
	mailbox.resource/MB_ReleaseMemory()

mailbox.resource/MB_BlankScreen                 mailbox.resource/MB_BlankScreen

   NAME
	MB_BlankScreen -- blank or unblank the screen (V1.1)

   SYNOPSIS
	state = MB_BlankScreen( blank )
	d0                      d0

	ULONG MB_BlankScreen(ULONG);

   FUNCTION
	Blanks or unblanks the display, using property tag BLANK_SCREEN
	(0x00040002).

   INPUTS
	blank           Non-zero to blank the screen, zero to unblank it.

   RESULTS
	state           Bit 0 of the state actually applied (1 = blanked), or
	                -1 on a mailbox transport error.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG state = MB_BlankScreen(TRUE);
	    Printf("Screen blanked: %ld\n", state);
	}

   SEE ALSO
	mailbox.resource/MB_AllocateBuffer(),
	mailbox.resource/MB_SetDisplayNum()

mailbox.resource/MB_GetAlphaMode               mailbox.resource/MB_GetAlphaMode

   NAME
	MB_GetAlphaMode -- read the framebuffer alpha channel mode (V1.1)

   SYNOPSIS
	mode = MB_GetAlphaMode()
	d0

	ULONG MB_GetAlphaMode(VOID);

   FUNCTION
	Reads the framebuffer's alpha channel mode, using property tag
	GET_ALPHA_MODE (0x00040007).

   RESULTS
	mode            0 = enabled (0 is opaque), 1 = reversed (0 is
	                transparent), 2 = ignored; or -1 on a mailbox
	                transport error.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG mode = MB_GetAlphaMode();
	    Printf("Alpha mode: %ld\n", mode);
	}

   SEE ALSO
	mailbox.resource/MB_SetAlphaMode(),
	mailbox.resource/MB_SetDisplayNum()

mailbox.resource/MB_GetARMMemory               mailbox.resource/MB_GetARMMemory

   NAME
	MB_GetARMMemory -- read the ARM-side memory base/size split (V1.1)

   SYNOPSIS
	MB_GetARMMemory( base, size )
	                 a0    a1

	VOID MB_GetARMMemory(ULONG *, ULONG *);

   FUNCTION
	Reads the base address and size of the memory reserved for the
	ARM side, using property tag GET_ARM_MEMORY (0x00010005).

   INPUTS
	base            Receives the ARM memory base address, or NULL to
	                discard.
	size            Receives the ARM memory size in bytes, or NULL to
	                discard.

   RESULTS
	On error, both *base and *size are set to -1.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG base, size;

	    MB_GetARMMemory(&base, &size);
	    Printf("ARM memory: %lx, %ld bytes\n", base, size);
	}

   SEE ALSO
	mailbox.resource/MB_GetVCMemory()

mailbox.resource/MB_GetBoardMACAddress   mailbox.resource/MB_GetBoardMACAddress

   NAME
	MB_GetBoardMACAddress -- read the board's MAC address (V1.1)

   SYNOPSIS
	MB_GetBoardMACAddress( hi, lo )
	                       a0  a1

	VOID MB_GetBoardMACAddress(ULONG *, ULONG *);

   FUNCTION
	Reads the board's 48-bit MAC address, using property tag
	GET_BOARD_MACADDR (0x00010003).

   INPUTS
	hi              Receives the address's high 32 bits, or NULL to
	                discard.
	lo              Receives the address's low 16 bits (in the low half-
	                word), or NULL to discard.

   RESULTS
	On error, both *hi and *lo are set to -1.

   EXAMPLES
	#include <proto/exec.h>
	#include <proto/dos.h>
	#include <proto/mailbox.h>
	#include <resources/mailbox.h>

	APTR MailboxBase = OpenResource(MAILBOXNAME);
	if (MailboxBase)
	{
	    ULONG hi, lo;

	    MB_GetBoardMACAddress(&hi, &lo);
	    Printf("MAC: %08lx%04lx\n", hi, lo >> 16);
	}

   NOTE
	Unlike MB_GetBoardSerial() below, this tag's response is a
	proper pair of 32-bit values and needs the full byte-swap,
	applied internally -- confirmed on real PiStorm/Emu68 hardware.

   SEE ALSO
	mailbox.resource/MB_GetBoardSerial()

